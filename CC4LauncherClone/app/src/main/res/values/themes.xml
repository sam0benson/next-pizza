<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CC4Launcher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="Theme.CC4Launcher.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="QuickIconButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint" tools:ignore="NewApi">@color/text_primary</item>
    </style>

</resources>
