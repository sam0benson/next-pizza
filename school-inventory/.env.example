# Не менее 32 случайных символов: openssl rand -hex 32. Шифрует секреты 2FA. Не меняйте после включения 2FA.
APP_SECRET=replace-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=replace-with-a-long-unique-password
SCHOOL_NAME=Моя школа
DATA_DIR=./data
